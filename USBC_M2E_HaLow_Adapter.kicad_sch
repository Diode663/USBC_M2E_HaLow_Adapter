		)
		(uuid "ac2dde6e-4bcd-5dcf-84d1-680d78793e1b")
	)
	(text "Layout: C1/C2 tight to VIN-GND, SW copper short, L1 and C4/C5 close, FB trace away from SW/L1."
		(exclude_from_sim no)
		(at 176.53 162.56 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "c7af7b69-c86a-5508-88ba-e730b4b8140b")
	)
	(text "Only C1 + C2 (10 uF) sit on VBUS, the USB inrush limit; the bulk is after the soft-started buck."
		(exclude_from_sim no)
		(at 176.53 154.94 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
