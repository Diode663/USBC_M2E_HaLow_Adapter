		)
		(uuid "97f9d746-dd56-5bb0-8399-b23d3bdccee9")
	)
	(text "H5: 2.5 mm SMT nut (LCSC C5301773), 29.75 mm from the socket centre on the peg side (card stop is 1.75 mm behind the pegs)."
		(exclude_from_sim no)
		(at 436.88 172.72 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
