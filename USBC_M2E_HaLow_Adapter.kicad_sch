	(text "GW16170 (MM8108-M20): 3.3 V on pins 2/4/72/74, USB D+ pin 3, D- pin 5. Nothing else is used."
		(exclude_from_sim no)
		(at 436.88 160.02 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "0274d6a2-1239-5cd6-8ee8-f29cedfc8baa")
	)
	(text "That is more than a 500 mA USB 2.0 port guarantees: use a USB 3 / USB-C host port or a powered hub."
		(exclude_from_sim no)
		(at 176.53 152.4 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "052bb233-0a15-524a-978c-76a2e7cc9ab3")
	)
	(text "MOUNTING (GROUNDED)"
		(exclude_from_sim no)
		(at 46.99 234 0)
		(effects
			(font
				(size 1.6 1.6)
				(bold yes)
			)
			(justify left)
		)
		(uuid "0945e1b7-39c2-5329-a689-f5d88a9ea50d")
	)
	(text "3.3 V / 3 A BUCK (U2 TPS563201)"
		(exclude_from_sim no)
		(at 171.45 97.03 0)
		(effects
			(font
				(size 1.6 1.6)
				(bold yes)
			)
			(justify left)
		)
		(uuid "142dd5db-0a20-53cf-83f4-f0f26aba4e2b")
	)
	(text "and 2.2 uH keeps the LC pole inside TI Table 2 (20-68 uF at up to 4.7 uH)."
		(exclude_from_sim no)
		(at 176.53 160.02 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "1607eac6-0525-5053-82e3-ecf8a7ba04df")
	)
	(text "U1 and D1 sit at J1, before anything else. Route D+/D- as a 90 ohm pair,"
		(exclude_from_sim no)
		(at 52.07 177.8 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "233e1dc4-9425-5f60-8317-2d1002e75e2f")
	)
	(text "FIDUCIALS & TEST PADS (NOT IN BOM)"
		(exclude_from_sim no)
		(at 166.37 234 0)
		(effects
			(font
				(size 1.6 1.6)
				(bold yes)
			)
			(justify left)
		)
		(uuid "31a911db-1119-51b5-9625-2cbdddf4556a")
	)
	(text "No PD controller: the host sees a default-power sink and supplies 5 V only."
		(exclude_from_sim no)
		(at 52.07 172.72 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "3845bb14-a7c9-51f0-9750-cfc2a31042dc")
	)
	(text "FID1-3: 1 mm fiducials for the"
